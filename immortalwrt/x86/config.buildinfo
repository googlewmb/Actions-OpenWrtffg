CONFIG_IB_STANDALONE=y
CONFIG_IMAGEOPT=y

# 内核核心
CONFIG_KERNEL_ARM64_CONTPTE=y
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y
