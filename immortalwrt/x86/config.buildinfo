#
# iStoreOS 24.10 最终完整配置 - H68K (RK3568)
# 专为云编译优化，包含所有需求功能 + 官方 is not set
#

CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h6xk=y
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="rockchip"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_generic"

CONFIG_CPU_TYPE="generic"
CONFIG_aarch64=y
CONFIG_ARCH="aarch64"

# 镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y

CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# 全局构建
CONFIG_ALL_KMODS=y
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
CONFIG_BPF_TOOLCHAIN_NONE=y
CONFIG_BUILD_PATENTED=y
CONFIG_CCACHE=y
CONFIG_DOCKER_NET_ENCRYPT=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_NET_OVERLAY=y
CONFIG_DOCKER_NET_TFTP=y
