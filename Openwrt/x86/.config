# ============================================================
# Target / H68K
# ============================================================
CONFIG_TARGET_rockchip=y                                      # Rockchip 目标平台
CONFIG_TARGET_rockchip_armv8=y                                # ARMv8 64 位架构
CONFIG_TARGET_MULTI_PROFILE=y                                 # 启用多设备 Profile
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_h68k=y    # 编译 Hinlink H68K
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h6xk is not set  # 不编译 OPC-H6XK
# CONFIG_TARGET_ALL_PROFILES is not set                        # 不编译全部设备 Profile

# ============================================================
# RootFS
# ============================================================
# CONFIG_TARGET_ROOTFS_EXT4FS is not set                       # 不生成独立 EXT4 RootFS
CONFIG_TARGET_ROOTFS_PARTSIZE=400                             # RootFS 分区大小 400MB

# ============================================================
# 基础系统
# ============================================================
CONFIG_PACKAGE_base-files=y                                   # OpenWrt 基础系统文件
CONFIG_PACKAGE_bash=y                                         # Bash 命令行 Shell
CONFIG_PACKAGE_autocore=y                                     # 自动检测/优化 CPU 架构
CONFIG_PACKAGE_urngd=y                                        # 系统随机数生成服务
CONFIG_PACKAGE_procps-ng=y                                    # Linux 进程管理工具
CONFIG_PACKAGE_procps-ng-ps=y                                 # ps 等进程查看命令
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y                     # GPIO 按键热插拔支持

# ============================================================
# 网络基础
# ============================================================
CONFIG_PACKAGE_netifd=y                                       # OpenWrt 网络接口管理服务
CONFIG_PACKAGE_ubus=y                                         # OpenWrt 系统消息总线
CONFIG_PACKAGE_ubus-cli=y                                     # UBus 命令行工具
CONFIG_PACKAGE_uci=y                                          # OpenWrt 配置管理接口
CONFIG_PACKAGE_dnsmasq=y                                      # DNS + DHCP 服务
CONFIG_PACKAGE_ethtool=y                                      # 网卡参数/状态管理工具
CONFIG_PACKAGE_ip-full=y                                      # 完整版 ip 网络管理工具
CONFIG_PACKAGE_tcpdump=y                                      # 网络数据包抓取分析工具

# ============================================================
# 防火墙
# ============================================================
CONFIG_PACKAGE_firewall4=y                                    # OpenWrt Firewall4 防火墙
CONFIG_PACKAGE_nftables=y                                     # nftables 防火墙规则工具

# ============================================================
# PPP / PPPoE
# ============================================================
CONFIG_PACKAGE_ppp=y                                          # PPP 协议用户空间支持
CONFIG_PACKAGE_ppp-mod-pppoe=y                                # PPPoE 用户空间拨号模块
CONFIG_PACKAGE_kmod-ppp=y                                     # PPP 内核核心模块
CONFIG_PACKAGE_kmod-pppoe=y                                   # PPPoE 内核支持
CONFIG_PACKAGE_kmod-pppox=y                                   # PPPoX 公共内核支持
# CONFIG_PACKAGE_kmod-mppe is not set                          # 不启用 MPPE 加密
# CONFIG_PACKAGE_kmod-pppol2tp is not set                      # 不启用 PPPoL2TP
# CONFIG_PACKAGE_kmod-pptp is not set                          # 不启用 PPTP
# CONFIG_PACKAGE_kmod-pppoa is not set                         # 不启用 PPPoA
# CONFIG_PACKAGE_kmod-ppp-synctty is not set                   # 不启用 PPP 同步串口

# ============================================================
# TCP / BBR 网络优化
# ============================================================
CONFIG_PACKAGE_kmod-tcp-bbr=y                                 # TCP BBR 拥塞控制算法

# ============================================================
# LuCI 核心
# ============================================================
CONFIG_PACKAGE_luci=y                                         # LuCI Web 管理界面
CONFIG_PACKAGE_luci-base=y                                    # LuCI 基础组件
CONFIG_PACKAGE_luci-ssl=y                                     # LuCI HTTPS/SSL 支持
CONFIG_PACKAGE_luci-compat=y                                  # LuCI 兼容组件
CONFIG_PACKAGE_luci-lib-fs=y                                  # LuCI 文件系统操作库
CONFIG_PACKAGE_luci-lib-ipkg=y                                # LuCI 软件包管理兼容库
CONFIG_LUCI_LANG_zh_Hans=y                                    # LuCI 简体中文语言支持
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y                         # LuCI 基础中文语言包

# ============================================================
# LuCI 网络 / 防火墙 / 软件包
# ============================================================
CONFIG_PACKAGE_luci-mod-network=y                             # LuCI 网络配置页面
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y                      # LuCI 网络中文语言包
CONFIG_PACKAGE_luci-app-firewall=y                            # LuCI 防火墙管理页面
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y                     # LuCI 防火墙中文语言包
CONFIG_PACKAGE_luci-app-package-manager=y                     # LuCI 软件包管理器
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y              # 软件包管理器中文语言包
CONFIG_PACKAGE_luci-app-clashoo=y
# ============================================================
# LuCI 常用插件
# ============================================================
CONFIG_PACKAGE_luci-app-upnp=y                                # LuCI UPnP 管理插件
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y                         # UPnP 中文语言包
CONFIG_PACKAGE_luci-app-filemanager=y                         # LuCI 文件管理器
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y                  # 文件管理器中文语言包
CONFIG_PACKAGE_luci-app-ttyd=y                                # LuCI Web 终端管理页面
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y                         # ttyd 中文语言包
CONFIG_PACKAGE_luci-app-hd-idle=y                             # LuCI 硬盘休眠管理
CONFIG_PACKAGE_luci-app-cpufreq=y                             # LuCI CPU 频率管理
CONFIG_PACKAGE_luci-app-statistics=y                          # CPU/内存/网络统计

# ============================================================
# Web Terminal
# ============================================================
CONFIG_PACKAGE_ttyd=y                                         # ttyd Web 终端服务

# ============================================================
# 代理 / DNS
# ============================================================
CONFIG_PACKAGE_luci-app-passwall=y                            # PassWall 代理管理
CONFIG_PACKAGE_luci-app-openclash=y                           # OpenClash 代理管理
CONFIG_PACKAGE_luci-app-homeproxy=y                           # HomeProxy 代理管理
CONFIG_PACKAGE_luci-app-lucky=y                               # Lucky DDNS/反向代理等工具
CONFIG_PACKAGE_luci-app-smartdns=y                            # SmartDNS 管理
CONFIG_PACKAGE_luci-app-mosdns=y                              # MosDNS 管理

# ============================================================
# 磁盘 / 分区 / 存储工具
# ============================================================
CONFIG_PACKAGE_block-mount=y                                  # OpenWrt 磁盘自动挂载管理
CONFIG_PACKAGE_mount-utils=y                                  # mount/umount 挂载工具
CONFIG_PACKAGE_fdisk=y                                        # 磁盘分区工具
CONFIG_PACKAGE_partx-utils=y                                  # 分区表辅助工具
CONFIG_PACKAGE_mtd=y                                          # MTD 闪存管理工具
CONFIG_PACKAGE_fstools=y                                      # OpenWrt 文件系统工具
CONFIG_PACKAGE_e2fsprogs=y                                    # EXT2/3/4 文件系统工具
CONFIG_PACKAGE_mkf2fs=y                                       # F2FS 文件系统创建工具
CONFIG_PACKAGE_zram-swap=y                                    # ZRAM 压缩交换空间

# ARM AutoCore
CONFIG_PACKAGE_autocore-arm=y

# 自动共享 KSMBD
CONFIG_PACKAGE_autoshare-ksmbd=n

# 自动共享 Samba
CONFIG_PACKAGE_autoshare-samba=y

# IPv6 Helper
CONFIG_PACKAGE_ipv6helper=y
# ============================================================
# 文件系统内核模块
# ============================================================
CONFIG_PACKAGE_kmod-fs-ext4=y                                 # EXT2/3/4 文件系统支持
CONFIG_PACKAGE_kmod-fs-f2fs=y                                 # F2FS 文件系统支持
CONFIG_PACKAGE_kmod-fs-vfat=y                                 # FAT/VFAT 文件系统支持
CONFIG_PACKAGE_kmod-fs-exfat=y                                # exFAT 文件系统支持
CONFIG_PACKAGE_kmod-fs-ntfs3=y                                # NTFS3 文件系统支持
CONFIG_PACKAGE_kmod-fs-btrfs=y                                # Btrfs 文件系统支持
CONFIG_PACKAGE_kmod-fs-xfs=y                                  # XFS 文件系统支持
CONFIG_PACKAGE_kmod-fs-hfs=y                                  # HFS 文件系统支持
CONFIG_PACKAGE_kmod-fs-hfsplus=y                              # HFS+ 文件系统支持
CONFIG_PACKAGE_kmod-fs-jfs=y                                 # JFS 文件系统支持
CONFIG_PACKAGE_kmod-fs-reiserfs=y                             # ReiserFS 文件系统支持
CONFIG_PACKAGE_kmod-fs-isofs=y                                # ISO9660 光盘文件系统支持
CONFIG_PACKAGE_kmod-fs-udf=y                                  # UDF 光盘文件系统支持
CONFIG_PACKAGE_kmod-fs-autofs4=y                              # AutoFS 自动挂载支持

# ============================================================
# USB 核心
# ============================================================
CONFIG_PACKAGE_kmod-usb-core=y                                # USB 核心框架
CONFIG_PACKAGE_kmod-usb2=y                                    # USB 2.0 主机支持
CONFIG_PACKAGE_kmod-usb3=y                                    # USB 3.0 主机支持

# ============================================================
# USB 存储
# ============================================================
CONFIG_PACKAGE_kmod-usb-storage=y                             # USB 大容量存储设备
CONFIG_PACKAGE_kmod-usb-storage-extras=y                      # USB 存储额外协议支持
CONFIG_PACKAGE_kmod-usb-storage-uas=y                         # USB Attached SCSI/UAS 支持
CONFIG_PACKAGE_usbutils=y                                     # lsusb 等 USB 管理工具

# ============================================================
# USB 网卡
# ============================================================
CONFIG_PACKAGE_kmod-usb-net=y                                 # USB 网络设备基础支持
CONFIG_PACKAGE_kmod-usb-net-aqc111=y                          # Aquantia AQC111 USB 2.5G 网卡
CONFIG_PACKAGE_kmod-usb-net-asix=y                            # ASIX USB 网卡通用驱动
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y                    # AX88179 USB 3.0 网卡
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y                         # CDC-EEM USB 网络协议
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y                       # CDC Ethernet USB 网卡
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y                        # CDC-MBIM 4G/5G Modem 网络
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y                         # CDC-NCM USB 高速网络
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y                      # CDC Subset 网络协议
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y                    # DM9601 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-hso=y                             # HSO Modem 网卡
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y                  # 华为 CDC-NCM Modem
CONFIG_PACKAGE_kmod-usb-net-ipheth=y                          # iPhone USB 网络共享
CONFIG_PACKAGE_kmod-usb-net-kalmia=y                          # Kalmia USB 网卡
CONFIG_PACKAGE_kmod-usb-net-kaweth=y                          # Kawasaki USB 网卡
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y                         # LAN78xx USB 网卡
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y                         # MCS7830 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-pegasus=y                         # Pegasus USB 网卡
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y                        # QMI WWAN 4G/5G Modem
CONFIG_PACKAGE_kmod-usb-net-rndis=y                           # RNDIS USB 网络共享
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y                         # RTL8150 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y                  # Sierra Wireless Modem
CONFIG_PACKAGE_kmod-usb-net-smsc75xx=y                        # SMSC75xx USB 网卡
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y                        # SMSC95xx USB 网卡
CONFIG_PACKAGE_kmod-usb-net-sr9700=y                          # SR9700 USB 网卡

# ============================================================
# USB Modem / 手机共享
# ============================================================
CONFIG_PACKAGE_kmod-usb-wdm=y                                 # USB WDM Modem 设备支持
CONFIG_PACKAGE_kmod-wwan=y                                    # WWAN 无线广域网内核框架
CONFIG_PACKAGE_wwan=y                                         # WWAN 用户空间支持
CONFIG_PACKAGE_usb-modeswitch=y                               # USB Modem 模式切换
CONFIG_PACKAGE_modemmanager=y                                 # ModemManager 4G/5G Modem 管理
CONFIG_PACKAGE_qmi-utils=y                                    # QMI Modem 工具
CONFIG_PACKAGE_umbim=y                                        # MBIM Modem 工具
CONFIG_PACKAGE_uqmi=y                                         # QMI Modem 工具
CONFIG_PACKAGE_libqmi=y                                       # QMI 用户空间库
CONFIG_PACKAGE_libmbim=y                                      # MBIM 用户空间库

# ============================================================
# 5G / MHI / MediaTek T7xx
# ============================================================
CONFIG_PACKAGE_kmod-mhi-bus=y                                 # MHI 总线框架
CONFIG_PACKAGE_kmod-mhi-net=y                                 # MHI 网络支持
CONFIG_PACKAGE_kmod-mhi-pci-generic=y                         # 通用 MHI PCIe 支持
CONFIG_PACKAGE_kmod-mhi-wwan-ctrl=y                           # MHI WWAN 控制通道
CONFIG_PACKAGE_kmod-mhi-wwan-mbim=y                           # MHI MBIM 支持
CONFIG_PACKAGE_kmod-qrtr=y                                    # Qualcomm QRTR 通信框架
CONFIG_PACKAGE_kmod-qrtr-mhi=y                                # QRTR MHI 支持
CONFIG_PACKAGE_kmod-mtk-t7xx=y                                # MediaTek T7xx 5G Modem 驱动

# ============================================================
# USB Gadget
# ============================================================
CONFIG_PACKAGE_kmod-usb-gadget=y                              # USB Gadget 框架
CONFIG_PACKAGE_kmod-usb-lib-composite=y                       # USB Composite Gadget
CONFIG_PACKAGE_kmod-usb-gadget-cdc-composite=y                # CDC Composite Gadget
CONFIG_PACKAGE_kmod-usb-gadget-eth=y                          # USB Gadget Ethernet
CONFIG_PACKAGE_kmod-usb-gadget-hid=y                          # USB Gadget HID
CONFIG_PACKAGE_kmod-usb-gadget-mass-storage=y                 # USB Gadget 虚拟存储
CONFIG_PACKAGE_kmod-usb-gadget-ncm=y                          # USB Gadget NCM
CONFIG_PACKAGE_kmod-usb-gadget-serial=y                       # USB Gadget 虚拟串口

# ============================================================
# USB 串口
# ============================================================
CONFIG_PACKAGE_kmod-usb-serial=y                              # USB Serial 基础框架
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y                       # CP210x USB 转串口
CONFIG_PACKAGE_kmod-usb-serial-ch341=y                        # CH341 USB 转串口
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y                         # FTDI USB 转串口
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y                       # PL2303 USB 转串口
CONFIG_PACKAGE_kmod-usb-acm=y                                 # USB ACM 串口设备

# ============================================================
# USB HID
# ============================================================
CONFIG_PACKAGE_kmod-usb-hid=y                                 # USB HID 设备支持
CONFIG_PACKAGE_kmod-hid-generic=y                             # 通用 HID 驱动

# ============================================================
# USB 打印机
# ============================================================
CONFIG_PACKAGE_kmod-usb-printer=y                             # USB 打印机支持

# ============================================================
# USB 音频
# ============================================================
CONFIG_PACKAGE_kmod-sound-core=y                              # Linux Sound 核心
CONFIG_PACKAGE_kmod-usb-audio=y                               # USB 声卡/音频设备支持

# ============================================================
# PCIe 工具
# ============================================================
CONFIG_PACKAGE_libpci=y                                       # PCI/PCIe 用户空间库
CONFIG_PACKAGE_pciutils=y                                     # lspci 等 PCIe 工具
CONFIG_PACKAGE_pciids=y                                       # PCI 设备 ID 数据库

# ============================================================
# H68K 有线网卡 / PHY
# ============================================================
CONFIG_PACKAGE_kmod-phylink=y                                # Linux PHYLINK 网络 PHY 管理
CONFIG_PACKAGE_kmod-of-mdio=y                                 # Device Tree MDIO 支持
CONFIG_PACKAGE_kmod-phy-realtek=y                             # Realtek PHY 驱动
CONFIG_PACKAGE_kmod-fixed-phy=y                               # Fixed PHY 支持
CONFIG_PACKAGE_kmod-r8125=y                                   # RTL8125 2.5G 网卡驱动
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8125-rss=y
# 不需要的 Realtek 有线网卡驱动
# CONFIG_PACKAGE_kmod-r8126 is not set                         # 禁用 RTL8126
# CONFIG_PACKAGE_kmod-r8168 is not set                         # 禁用 RTL8168
# CONFIG_PACKAGE_kmod-r8169 is not set                         # 禁用 RTL8169

# ============================================================
# MediaTek WiFi 基础
# ============================================================
CONFIG_PACKAGE_kmod-mt76-core=y                               # MT76 WiFi 核心驱动
CONFIG_PACKAGE_kmod-mt76-connac=y                             # MediaTek Connac 平台支持
CONFIG_PACKAGE_kmod-mt76-usb=y                                # MT76 USB WiFi 支持

# ============================================================
# MT7921 PCIe
# ============================================================
CONFIG_PACKAGE_kmod-mt7921-common=y                           # MT7921 通用驱动
CONFIG_PACKAGE_kmod-mt7921-firmware=y                         # MT7921 固件
CONFIG_PACKAGE_kmod-mt7921e=y                                 # MT7921 PCIe 驱动

# ============================================================
# MT7921 USB
# ============================================================
CONFIG_PACKAGE_kmod-mt7921u=y                                 # MT7921 USB 驱动

# ============================================================
# MT7916
# ============================================================
CONFIG_PACKAGE_kmod-mt7916-firmware=y                         # MT7916 固件

# ============================================================
# MT7922 PCIe
# ============================================================
CONFIG_PACKAGE_kmod-mt7922-firmware=y                         # MT7922 固件

# ============================================================
# WiFi AP / WPA
# ============================================================
CONFIG_PACKAGE_hostapd-openssl=y                              # OpenSSL 版 Hostapd
CONFIG_PACKAGE_wpa-supplicant-openssl=y                       # OpenSSL 版 WPA Supplicant
CONFIG_PACKAGE_wpa-cli=y                                      # WPA 命令行管理工具
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set                 # 不使用基础版 wpad

# ============================================================
# WiFi LuCI / 无线信息
# ============================================================
CONFIG_PACKAGE_luci-mod-network=y                             # LuCI 网络配置模块
CONFIG_PACKAGE_rpcd-mod-iwinfo=y                              # RPCD 无线信息模块
CONFIG_PACKAGE_libiwinfo=y                                    # OpenWrt 无线信息库
CONFIG_PACKAGE_libiwinfo-data=y                               # 无线设备/芯片数据

# ============================================================
# 文件共享 / NAS
# ============================================================
CONFIG_PACKAGE_samba4-server=y                                # Samba4 SMB/CIFS 文件共享服务
CONFIG_PACKAGE_samba4-utils=y                                 # Samba4 管理工具
CONFIG_PACKAGE_nfs-utils=y                                    # NFS 文件共享工具
CONFIG_PACKAGE_luci-app-samba4=y
# ============================================================
# IPv6
# ============================================================
CONFIG_PACKAGE_kmod-ipv6=y                                    # IPv6 内核支持
CONFIG_PACKAGE_odhcp6c=y                                      # IPv6 DHCP 客户端
CONFIG_PACKAGE_odhcpd-ipv6only=y                              # IPv6 DHCP/RA 服务

# ============================================================
# Crypto / CRC
# ============================================================
CONFIG_PACKAGE_kmod-crypto-hash=y                             # Linux Crypto Hash 框架
CONFIG_PACKAGE_kmod-crypto-crc32c=y                           # CRC32C 校验模块
CONFIG_PACKAGE_kmod-lib-crc16=y                               # CRC16 内核库
CONFIG_PACKAGE_kmod-lib-crc-ccitt=y                           # CRC-CCITT 内核库

# ============================================================
# 禁用不需要的 WiFi 驱动
# ============================================================
# CONFIG_PACKAGE_kmod-rtl8xxxu is not set                     # 禁用 RTL8xxxU
# CONFIG_PACKAGE_kmod-rtl8812au is not set                    # 禁用 RTL8812AU
# CONFIG_PACKAGE_kmod-rtl8821cu is not set                    # 禁用 RTL8821CU
# CONFIG_PACKAGE_kmod-rtw88 is not set                         # 禁用 Realtek RTW88
# CONFIG_PACKAGE_kmod-rtw89 is not set                         # 禁用 Realtek RTW89
# CONFIG_PACKAGE_kmod-mt7915e is not set                       # 禁用 MT7915 PCIe
# CONFIG_PACKAGE_kmod-mt7992e is not set                       # 禁用 MT7992 PCIe
# CONFIG_PACKAGE_kmod-mt7996e is not set                       # 禁用 MT7996 PCIe
